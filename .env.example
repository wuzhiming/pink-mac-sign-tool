# 端口 (可选，默认 3000)
PORT=3000

# SUD 日志解密工具（默认使用项目内 bin/sud-log-parser-arm64，仅适用于 macOS arm64）
# SUD_LOG_PARSER_PATH=/absolute/path/to/sud-log-parser-arm64

# 签名身份 (例: "Developer ID Application: Your Name (TeamID)")
APPLE_DEVELOPER_ID=

# Apple ID 邮箱
APPLE_ID=

# App 专用密码 (请从 appleid.apple.com 生成)
APPLE_PASSWORD=

# 团队 ID (Team ID)
APPLE_TEAM_ID=
